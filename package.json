{
  "name": "cacp",
  "private": true,
  "version": "0.0.0",
  "description": "Control and supervision platform for Claude Code agents",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @cacp/db generate",
    "db:migrate": "pnpm --filter @cacp/db migrate",
    "dev:backend": "pnpm --filter @cacp/backend dev",
    "dev:daemon": "pnpm --filter @cacp/daemon dev"
  }
}
